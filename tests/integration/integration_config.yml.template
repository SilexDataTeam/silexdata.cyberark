# Copy this file to integration_config.yml and fill in real CyberArk CCP
# credentials to run the live (service-dependent) integration tests.
# integration_config.yml is git-ignored and must never be committed.

# Override the placeholder credentials from setup_cyberark/defaults:
setup_cyberark_url: "https://cyberark.example.com"
setup_cyberark_app_id: "MyApp"
setup_cyberark_client_cert: ""
setup_cyberark_client_key: ""

# Fail the run (instead of warning and skipping live tests) when the CyberArk
# CCP service is unreachable. Recommended for pipelines that require live
# coverage.
# setup_cyberark_require_service: true
